GOOGLE_API_KEY=your-gemini-api-key-here
DATABASE_URL=sqlite:///./dinner_decider.db
GEMINI_MODEL=gemini-2.5-flash
# Hour (0-23) to generate daily suggestions, in TIMEZONE below
SCHEDULER_HOUR=17
# IANA timezone the scheduler runs in, e.g. Australia/Sydney
TIMEZONE=UTC
# Comma-separated origins allowed by CORS (your frontend URL in production)
CORS_ORIGINS=http://localhost:5173
# Shared passcode that gates the app. Leave blank for OPEN MODE (local dev only).
HOUSEHOLD_PASSCODE=
# Secret for signing session cookies. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# Leave blank to use an ephemeral key (logins reset on restart).
SESSION_SECRET=
# Optional: webhook notified when daily suggestions are generated (e.g. an
# ntfy.sh topic URL like https://ntfy.sh/my-dinner-topic). Blank disables it.
NOTIFY_WEBHOOK_URL=
